{
  "name": "yodev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm brand:check --local && pnpm build",
    "brand:sync": "node scripts/sync-brand.mjs",
    "brand:check": "node scripts/sync-brand.mjs --check",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "test:redis": "node --experimental-strip-types --test tests/integration/*.test.mjs",
    "audit:runtime": "pnpm audit --prod --audit-level high",
    "readiness": "node --env-file-if-exists=.env.local scripts/check-readiness.mjs",
    "smoke": "node scripts/smoke.mjs",
    "contact:smoke": "node scripts/contact-smoke.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.3.8",
    "next-intl": "^4.6.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24 <25"
  },
  "pnpm": {
    "overrides": {
      "@parcel/watcher": "^2.6.0",
      "sharp": "^0.35.5",
      "source-map-js": "^1.2.2"
    }
  }
}
