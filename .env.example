# Public canonical origin (also used at build time for metadata).
NEXT_PUBLIC_SITE_URL=https://www.yodev.fr
# Optional public booking URL. Empty hides the calendar card.
NEXT_PUBLIC_BOOKING_URL=

# Server only. Use a verified sender and a test recipient in preview.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=

# Dedicated Redis REST database/token with EVAL, GET, INCR, EXPIRE and TTL rights.
# Use different credentials/databases for preview and production.
CONTACT_REDIS_REST_URL=
CONTACT_REDIS_REST_TOKEN=
# Generate at least 32 random bytes with your secret manager; never commit it.
CONTACT_RATE_LIMIT_SECRET=

# Vercel supplies VERCEL=1 and its trusted IP header automatically.
# On another host, set ONLY a header that your ingress overwrites.
CONTACT_TRUSTED_IP_HEADER=
